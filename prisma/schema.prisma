generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BodyStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
}

enum SubscriptionPlan {
  PERSONAL
  ORGANIZATIONAL
  UNLIMITED
}

enum PaymentClaimStatus {
  SUBMITTED
  NEEDS_EVIDENCE
  REJECTED
}

enum StaffRole {
  ELECTORAL_ADMIN
  PLATFORM_ADMIN
}

enum ElectionStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model ElectoralBody {
  id                 String           @id @default(cuid())
  name               String
  contactPerson      String
  email              String           @unique
  phone              String?
  status             BodyStatus       @default(PENDING)
  paymentStatus      PaymentStatus    @default(UNPAID)
  subscriptionType   SubscriptionPlan @default(PERSONAL)
  hasCustomVoterId   Boolean          @default(false)
  customVoterIdField String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  emailVerifiedAt    DateTime?

  emailChallenges EmailVerificationChallenge[]
  paymentClaims   PaymentClaim[]
  reviews       OrganizationReview[]
  staffAccounts StaffAccount[]
  elections     Election[]
  voters        Voter[]
}

model StaffAccount {
  id               String        @id @default(cuid())
  email            String        @unique
  passwordHash     String
  role             StaffRole
  electoralBodyId  String?
  isDisabled       Boolean       @default(false)
  failedAttempts   Int           @default(0)
  lockedUntil      DateTime?
  mfaSecretEncrypted String?
  mfaLastCounter    BigInt?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  electoralBody    ElectoralBody? @relation(fields: [electoralBodyId], references: [id], onDelete: Restrict)
  sessions         StaffSession[]
  auditEvents      AuthAuditEvent[]
  organizationReviews OrganizationReview[]
  paymentReviews PaymentClaim[]

  @@index([electoralBodyId, role])
}

model StaffSession {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  accountId  String
  createdAt  DateTime     @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  mfaVerifiedAt DateTime?

  account    StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId, expiresAt])
}

model AuthThrottle {
  key          String   @id
  windowStart  DateTime
  attempts     Int      @default(0)
}

model AuthAuditEvent {
  id         String        @id @default(cuid())
  accountId  String?
  action     String
  createdAt  DateTime      @default(now())
  account    StaffAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
}

model OrganizationReview {
  id             String       @id @default(cuid())
  electoralBodyId String
  reviewerId     String
  decision       String
  reason         String
  createdAt      DateTime     @default(now())

  body           ElectoralBody @relation(fields: [electoralBodyId], references: [id], onDelete: Restrict)
  reviewer       StaffAccount  @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([electoralBodyId, createdAt])
}

model Election {
  id               String         @id @default(cuid())
  electoralBodyId  String
  title            String
  description      String?
  startAt          DateTime?
  endAt            DateTime?
  status           ElectionStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  electoralBody ElectoralBody @relation(fields: [electoralBodyId], references: [id], onDelete: Restrict)
  positions     Position[]
  candidates    Candidate[]
  ballots       Ballot[]
  voters        Voter[]

  @@index([electoralBodyId, status])
}

model Position {
  id          String   @id @default(cuid())
  electionId  String
  title       String
  description String?
  maxVotes    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  election    Election    @relation(fields: [electionId], references: [id], onDelete: Restrict)
  candidates  Candidate[]
  votes       Vote[]

  @@index([electionId])
}

model Candidate {
  id          String   @id @default(cuid())
  electionId  String
  positionId  String
  name        String
  manifesto   String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  election    Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  position    Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  votes       Vote[]

  @@index([electionId, positionId])
}

model Voter {
  id              String   @id @default(cuid())
  electoralBodyId String
  electionId      String
  fullName        String
  email           String?
  phone           String?
  voterCode       String   @unique
  otpHash         String?
  otpExpiresAt    DateTime?
  loginAttempts   Int      @default(0)
  lastLoginAt     DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  electoralBody ElectoralBody @relation(fields: [electoralBodyId], references: [id], onDelete: Restrict)
  election      Election     @relation(fields: [electionId], references: [id], onDelete: Restrict)
  ballots       Ballot[]

  @@index([electoralBodyId, electionId])
  @@unique([electionId, email])
}

model Ballot {
  id          String   @id @default(cuid())
  electionId  String
  voterId     String
  submittedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  election Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  voter    Voter    @relation(fields: [voterId], references: [id], onDelete: Restrict)
  votes    Vote[]

  @@unique([electionId, voterId])
  @@index([electionId, submittedAt])
}

model Vote {
  id          String   @id @default(cuid())
  ballotId    String
  positionId  String
  candidateId String
  createdAt   DateTime @default(now())

  ballot    Ballot    @relation(fields: [ballotId], references: [id], onDelete: Restrict)
  position  Position  @relation(fields: [positionId], references: [id], onDelete: Restrict)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@unique([ballotId, positionId])
  @@index([positionId, candidateId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

model PlatformSettings {
  id             String   @id @default(cuid())
  platformName   String   @default("Octalve Vote")
  enablePayments Boolean  @default(false)
  supportEmail   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EmailVerificationChallenge {
  id             String   @id @default(cuid())
  electoralBodyId String
  tokenHash      String   @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())
  electoralBody  ElectoralBody @relation(fields: [electoralBodyId], references: [id], onDelete: Restrict)

  @@index([electoralBodyId, expiresAt])
}

model PaymentClaim {
  id               String @id @default(cuid())
  electoralBodyId  String
  reference        String @unique
  amountKobo       BigInt
  currency         String @default("NGN")
  note             String?
  status           PaymentClaimStatus @default(SUBMITTED)
  reviewReason     String?
  reviewerId       String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())

  electoralBody ElectoralBody @relation(fields: [electoralBodyId], references: [id], onDelete: Restrict)
  reviewer StaffAccount? @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([electoralBodyId, createdAt])
  @@index([status, createdAt])
}
