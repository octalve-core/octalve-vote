# Database credentials are private. Use a dedicated empty PostgreSQL database for development.
DATABASE_URL=
# Must be >=32 random characters; NEVER put a production secret into Git or browser code.
AUTH_THROTTLE_SECRET=
# Default OFF. Do not enable for production without independently tested MFA,
# email verification, rate limits, migration history and operational audit controls.
ENABLE_STAFF_LOGIN=false
ENABLE_ELECTORAL_SIGNUP=false

# Batch 4: Draft-only election creation. Disabled unless explicitly reviewed.
ENABLE_DRAFT_ELECTIONS=false
# Operational cap for pilot only. Must be configured by owner; NOT a paid-plan entitlement.
# DRAFT_ELECTION_CAPACITY=5

# Batch 5: Admin authenticator-based sign-in; disabled by default.
ENABLE_ADMIN_MFA=false
# 32-byte AES encryption key encoded as 64 hexadecimal characters; NEVER in Git.
MFA_ENCRYPTION_KEY=
# Explicit operational gate for reviewing verified electoral applications.
ENABLE_ORGANIZATION_APPROVALS=false
# Draft election setup remains disabled until manually enabled for testing.
ENABLE_ELECTION_CONFIGURATION=false

# Batch 6: SMTP delivered, one-time email verification (OFF until configured).
ENABLE_EMAIL_VERIFICATION=false
APP_ORIGIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Voter import is separate from invitations and voting; default OFF.
ENABLE_VOTER_REGISTER=false
# Payment claims are NOT verified payments; review cannot mark PAID; default OFF.
ENABLE_PAYMENT_REVIEW=false
