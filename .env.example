# Database credentials are private. Use a dedicated empty PostgreSQL database for development.
DATABASE_URL=
# Must be >=32 random characters; NEVER put a production secret into Git or browser code.
AUTH_THROTTLE_SECRET=
# Default OFF. Do not enable for production without independently tested MFA,
# email verification, rate limits, migration history and operational audit controls.
ENABLE_STAFF_LOGIN=false
ENABLE_ELECTORAL_SIGNUP=false
